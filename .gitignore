#########################################################################################################
##	This is an example .gitignore file for Vivado, please treat it as an example as 
##	it might not be complete. In addition, XAPP 1165 should be followed.
#########################################################################################################
#########
#Exclude all
#########
*
!.gitignore
###########################################################################
##	DO NOT IGNORE THE FOLLOWING FILES
###########################################################################
!Bender.*
Bender.local
!AI_Trigger_System/
!AI_Trigger_System/**/

!HDL/
!HDL/**

!build/vivado_post_impl_saif/xsim/xsim.log

!data/
!data/**

!materials/
!materials/**

!analysis/
!analysis/**

!docs/
!docs/**

!scripts/
!scripts/**
scripts/__pycache__/
scripts/**/*.pyc

!build/
build/*
!build/vivado_ooc_ai_trigger/
build/vivado_ooc_ai_trigger/*
!build/vivado_ooc_ai_trigger/reports/
!build/vivado_ooc_ai_trigger/reports/**
!build/vivado_ooc_ai_trigger/checkpoints/
!build/vivado_ooc_ai_trigger/checkpoints/*.dcp
!build/vivado_ooc_ai_trigger/generated/
!build/vivado_ooc_ai_trigger/generated/*.tcl
!build/vivado_ooc_ai_trigger_wrap/
build/vivado_ooc_ai_trigger_wrap/*
!build/vivado_ooc_ai_trigger_wrap/reports/
!build/vivado_ooc_ai_trigger_wrap/reports/**
!build/vivado_ooc_ai_trigger_wrap/checkpoints/
!build/vivado_ooc_ai_trigger_wrap/checkpoints/*.dcp
!build/vivado_ooc_ai_trigger_wrap/generated/
!build/vivado_ooc_ai_trigger_wrap/generated/*.tcl
!build/vivado_post_impl_saif/
build/vivado_post_impl_saif/*
!build/vivado_post_impl_saif/reports/
!build/vivado_post_impl_saif/reports/**
!build/vivado_post_impl_saif/activity/
build/vivado_post_impl_saif/activity/*.saif
!build/vivado_post_impl_saif/xsim/
!build/vivado_post_impl_saif/xsim/*.csv
!build/vivado_post_impl_saif/generated/
!build/vivado_post_impl_saif/generated/*.tcl

# Ignore bender dependency cache (large git objects)
.bender/

# Ignore large data/output files
data/*.npy
data/*.pdf
analysis/**/*.npy
analysis/**/*.txt
###########################################################################
##	VIVADO
###########################################################################
#########
#Source files:
#########
#Do NOT ignore VHDL, Verilog, block diagrams or EDIF files.
!*.vhd
!*.v
!*.sv
!*.bd
!*.edif
#########
#IP files
#########
#.xci: synthesis and implemented not possible - you need to return back to the previous version to generate output products
#.xci + .dcp: implementation possible but not re-synthesis
#*.xci(www.spiritconsortium.org)
!*.xci
#*.dcp(checkpoint files)
!*.dcp
!*.vds
!*.pb
#All bd comments and layout coordinates are stored within .ui
!*.ui
!*.ooc
#########
#System Generator
#########
!*.mdl
!*.slx
!*.bxml
#########
#Simulation logic analyzer
#########
!*.wcfg
!*.coe
#########
#MIG
#########
!*.prj
!*.mem
#########
#Project files
#########
#XPR  +  *.XML ? XPR (Files are merged into a single XPR file for 2014.1 version)
#Do NOT ignore *.xpr files
!*.xpr
#Include *.xml files for 2013.4 or earlier version
!*.xml
#########
#Constraint files
#########
#Do NOT ignore *.xdc files
!*.xdc
#########
#TCL - files
#########
!*.tcl
#########
#Journal - files
#########
#!*.jou
#########
#Reports
#########
!*.rpt
!*.txt
!*.vdi
#########
#C-files
#########
!*.c
!*.h
!*.elf
!*.bmm
!*.xmp

.DS_Store
**/.DS_Store

# Keep only useful outputs from the OOC timing/resource flow.
build/vivado_ooc_ai_trigger/*
!build/vivado_ooc_ai_trigger/reports/
!build/vivado_ooc_ai_trigger/reports/**
!build/vivado_ooc_ai_trigger/checkpoints/
!build/vivado_ooc_ai_trigger/checkpoints/*.dcp
!build/vivado_ooc_ai_trigger/generated/
!build/vivado_ooc_ai_trigger/generated/*.tcl
!build/vivado_ooc_ai_trigger_wrap/
build/vivado_ooc_ai_trigger_wrap/*
!build/vivado_ooc_ai_trigger_wrap/reports/
!build/vivado_ooc_ai_trigger_wrap/reports/**
!build/vivado_ooc_ai_trigger_wrap/checkpoints/
!build/vivado_ooc_ai_trigger_wrap/checkpoints/*.dcp
!build/vivado_ooc_ai_trigger_wrap/generated/
!build/vivado_ooc_ai_trigger_wrap/generated/*.tcl
!build/vivado_post_impl_saif/
build/vivado_post_impl_saif/*
!build/vivado_post_impl_saif/reports/
!build/vivado_post_impl_saif/reports/**
!build/vivado_post_impl_saif/activity/
build/vivado_post_impl_saif/activity/*.saif
!build/vivado_post_impl_saif/xsim/
!build/vivado_post_impl_saif/xsim/*.csv
!build/vivado_post_impl_saif/generated/
!build/vivado_post_impl_saif/generated/*.tcl
